# ============================================================
# Price Feeder - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# REQUIRED: Account private key
# The account must be whitelisted as a price feeder and have
# enough funds to pay transaction gas.
# ------------------------------------------------------------
ACCOUNT_PK_SECRET=<your_private_key>

# Multiple accounts (optional, alternative to the above):
# Comma-separated in one variable:
#   ACCOUNT_PK_SECRET=<pk1>,<pk2>,<pk3>
# Or one variable per account:
#   ACCOUNT_PK_SECRET_1=<pk1>
#   ACCOUNT_PK_SECRET_2=<pk2>


# ------------------------------------------------------------
# OPTIONAL: Override the RPC node URI
# Defaults to the value in config.json if not set.
# Example: https://public-node.rsk.co
# ------------------------------------------------------------
#APP_CONNECTION_URI=


# ------------------------------------------------------------
# OPTIONAL: Override the entire config as a JSON string
# Useful for CI/CD or dynamic configuration.
# If set, --config argument is ignored.
# ------------------------------------------------------------
#APP_CONFIG=


# ------------------------------------------------------------
# AWS CloudWatch metrics (optional)
# Required only when running on AWS and you want heartbeat /
# error metrics pushed to CloudWatch.
# On ECS, use task role or ECS secrets instead of these vars.
# ------------------------------------------------------------
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=us-west-1

# Name used as the CloudWatch metric dimension (e.g. moc-mainnet)
#PRICE_FEEDER_NAME=
